#!/usr/bin/env bash
# ============================================================================
# Stock Monitor — Configuration
# ============================================================================

# Tickers are read from ../config.yaml so scraper and monitor stay in sync.

# Path to Finviz scraped data directory (relative to repo root)
# This repo stores: $FINVIZ_DATA_DIR/<TICKER>/<YYYY-MM-DD>/finviz_quote.json
FINVIZ_DATA_DIR="data"

# Reports output directory (relative to repo root)
REPORTS_DIR="monitor/reports"

# Prompts directory (relative to repo root)
PROMPTS_DIR="monitor/prompts"

# AI provider for monitor reports: claude or codex
: "${MONITOR_AI_PROVIDER:=codex}"

# Optional model overrides. The Claude CLI accepts aliases such as "sonnet".
: "${MONITOR_CLAUDE_MODEL:=sonnet}"
: "${MONITOR_CODEX_MODEL:=gpt-5.6-terra}"

# Optional CLI path overrides. Useful for launchd/non-interactive shells.
: "${MONITOR_CLAUDE_BIN:=}"
: "${MONITOR_CODEX_BIN:=/Users/krutik/.local/bin/codex}"

# Number of ledger days to feed into daily context
LEDGER_LOOKBACK=10

# Number of ledger days to feed into weekly context (full week + buffer)
WEEKLY_LEDGER_LOOKBACK=30

# Auto git-commit reports after each run? (true/false)
AUTO_GIT_COMMIT=true

# Git commit message prefix
GIT_MSG_PREFIX="[stock-monitor]"

# Day of week for weekly deep analysis (0=Sun, 6=Sat)
WEEKLY_DAY=6

# Use scraped articles instead of live web search for the news scan (Step 4).
# true  → top 5 articles ranked from the day's scrape data; no WebSearch/WebFetch calls.
# false → existing behaviour: Claude calls WebSearch and WebFetch during analysis.
: "${WEBSEARCH_OFF:=false}"
