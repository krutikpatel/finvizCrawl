  "metadata": {
    "title": "SpaceX's $2 Trillion Hardware Moat Is Basically A Knicks NFT, Says Wall Street Veteran",
    "byline": null,
    "published_at": null,
    "site_name": "finance.yahoo.com",
    "language": null
