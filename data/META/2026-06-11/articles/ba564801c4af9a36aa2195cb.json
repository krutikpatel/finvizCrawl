  "metadata": {
    "title": "Meta's AI Workforce Academy Wins Praise From Former Trump Adviser, Ex-Facebook Exec: 'Hope More Companies Follow Suit'",
    "byline": null,
    "published_at": null,
    "site_name": "finance.yahoo.com",
    "language": null
