    "title": "AethexAI, A Full-Stack Voice AI Infrastructure Startup, Raises $3M In Pre-Seed Round To Level The Playing Field For Enterprises In Emerging Markets",
    "byline": null,
    "published_at": null,
    "site_name": "finance.yahoo.com",
    "language": null
