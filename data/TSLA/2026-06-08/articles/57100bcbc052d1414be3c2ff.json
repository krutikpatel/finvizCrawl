    "title": "Patrick Bet-David Show’s Adam Sosnick Compares His Bitcoin 'Dry Powder' To The Tesla Cash That Built SpaceX",
    "byline": null,
    "published_at": null,
    "site_name": "finance.yahoo.com",
    "language": null
