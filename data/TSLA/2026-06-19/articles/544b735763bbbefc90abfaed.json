    "title": "RIVN Stock: Rivian Reportedly Hit With Class-Action Lawsuit Over False Gen 1 Vehicle Autonomy Claims",
    "byline": null,
    "published_at": null,
    "site_name": "finance.yahoo.com",
    "language": null
