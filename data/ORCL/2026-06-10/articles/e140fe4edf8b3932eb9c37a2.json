  "metadata": {
    "title": "Can Oracle Deliver Another AI-Fueled Quarter? Analysts Believe The Setup Looks ‘Favorable’",
    "byline": null,
    "published_at": null,
    "site_name": "finance.yahoo.com",
    "language": null
