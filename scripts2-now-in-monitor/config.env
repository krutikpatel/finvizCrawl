#!/usr/bin/env bash
# ============================================================================
# Stock Monitor — Configuration
# ============================================================================

# Tickers to monitor (space-separated)
WATCHLIST="AAPL"

# Path to Finviz scraped data directory (relative to repo root)
# The system looks for: $FINVIZ_DATA_DIR/<TICKER>/<date>.csv
# or:                   $FINVIZ_DATA_DIR/<TICKER>/latest.csv
# or:                   $FINVIZ_DATA_DIR/<TICKER>.csv
# Adjust FIND_FINVIZ_DATA() in the run scripts if your layout differs.
FINVIZ_DATA_DIR="data"

# Reports output directory (relative to repo root)
REPORTS_DIR="monitor/reports"

# Prompts directory (relative to repo root)
PROMPTS_DIR="monitor/prompts"

# Number of ledger days to feed into daily context
LEDGER_LOOKBACK=10

# Number of ledger days to feed into weekly context (full week + buffer)
WEEKLY_LEDGER_LOOKBACK=30

# Auto git-commit reports after each run? (true/false)
AUTO_GIT_COMMIT=true

# Git commit message prefix
GIT_MSG_PREFIX="[stock-monitor]"

# Day of week for weekly deep analysis (0=Sun, 6=Sat)
WEEKLY_DAY=6
