<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.finzwiz.workflow</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/krutik/technical/finvizCrawl/scripts/workflow.sh</string>
    </array>

    <!-- Run at 7:00 AM system local time, Monday through Friday -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key> <integer>2</integer>
            <key>Hour</key>    <integer>7</integer>
            <key>Minute</key>  <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key> <integer>3</integer>
            <key>Hour</key>    <integer>7</integer>
            <key>Minute</key>  <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key> <integer>4</integer>
            <key>Hour</key>    <integer>7</integer>
            <key>Minute</key>  <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key> <integer>5</integer>
            <key>Hour</key>    <integer>7</integer>
            <key>Minute</key>  <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key> <integer>6</integer>
            <key>Hour</key>    <integer>7</integer>
            <key>Minute</key>  <integer>0</integer>
        </dict>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/krutik/technical/finvizCrawl</string>

    <!-- Captured separately from per-run log so launchd output is always visible -->
    <key>StandardOutPath</key>
    <string>/Users/krutik/technical/finvizCrawl/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/krutik/technical/finvizCrawl/logs/launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Tickers are read from config.yaml by default. Override here only if needed. -->
        <!-- <key>FINZWIZ_TICKERS</key> -->
        <!-- <string>TSLA AAPL META</string> -->
        <!-- Optional: set your Gmail address to receive a daily summary email -->
        <!-- <key>FINZWIZ_EMAIL</key> -->
        <!-- <string>you@gmail.com</string> -->

    </dict>

    <!-- Rerun missed executions when the Mac wakes from sleep -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
